[sub_resource type="GDScript" id="GDScript_e44ma"]
script/source = "extends Area3D


func _on_body_entered(body: Node3D) -> void:
	if body.is_in_group(\"player\"):
		GLOBAL.add_event_on_story(\"1st_lap_ended\", Callable(self, \"_on_1st_lap_ended\"))
		set_deferred(\"monitoring\", false)

func _on_1st_lap_ended():
	$\"../..\".add_child(load(\"res://scenes/LapWalls/2_nd_lap_walls.tscn\").instantiate())
	$\"../..\".add_child(load(\"res://scenes/LapWalls/stalker.tscn\").instantiate())
	var tween : Tween = get_tree().create_tween().set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	tween.tween_property(get_tree().get_first_node_in_group(\"loop_2nd_music_layer\"), \"volume_db\", 0.0, 3)
	tween.tween_callback(func(): $\"..\".queue_free())
"

