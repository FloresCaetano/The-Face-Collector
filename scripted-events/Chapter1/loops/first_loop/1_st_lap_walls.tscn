[sub_resource type="GDScript" id="GDScript_uufvg"]
script/source = "extends Area3D

func _ready() -> void:
	set_physics_process(false)

func _on_body_entered(body: Node3D) -> void:
	if body.is_in_group(\"player\") && GLOBAL.events_on_story.has(\"basement_arrival\"):
		$Timer.start()
		set_physics_process(true)

func _physics_process(_delta: float) -> void:
	var time_left = $Timer.time_left
	if time_left > 1.4 && time_left < 1.5:
		$\"../../Interactables/Doors/Door8\".locked_anim_go()
	elif time_left > 0.9 && time_left < 1.0:
		$\"../../Interactables/Doors/Door8\".locked_anim_go()
	elif time_left > 0.7 && time_left < 0.8:
		$\"../../Interactables/Doors/Door8\".locked_anim_go()
	elif time_left > 0.2 && time_left < 0.3:
		$\"../../Interactables/Doors/Door8\".locked_anim_go()
	monitoring = false


func _on_timer_timeout() -> void:
	$\"../../Trigger/00Knocks\".play()
	$\"../../Trigger/00Knocks\".volume_db = 30
	$\"../../Trigger/00Knocks\".connect(\"finished\", func(): $\"../../Trigger/00Knocks\".queue_free(); self.queue_free())
"

