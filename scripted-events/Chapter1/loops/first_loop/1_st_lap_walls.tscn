[sub_resource type="GDScript" id="GDScript_cmjaj"]
script/source = "extends Area3D

func _on_body_entered(body: Node3D) -> void:
	if body.is_in_group(\"player\") && GLOBAL.events_on_story.has(\"basement_arrival\"):
		$\"../../Interactables/Doors/Door8\".open_door()
		$\"../../Interactables/Doors/Door8\".unlock_steps = 0
		queue_free()
"

