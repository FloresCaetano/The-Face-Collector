[sub_resource type="GDScript" id="GDScript_cymo7"]
script/source = "extends Node3D
var already_look := false
func _on_look_event():
	if !already_look:
		$\"..\".get_node(\"1st_lap\").already_look = true
		$\"..\".get_node(\"1st_lap3\").already_look = true
		var BackgroundPlayer : AudioStreamPlayer3D = get_tree().get_first_node_in_group(\"background_audio_player\")
		var tween : Tween = get_tree().create_tween().set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		tween.tween_property(BackgroundPlayer, \"volume_db\", -10, 0.5)
		tween.tween_callback(
			func():
				get_tree().get_first_node_in_group(\"player\").get_node(\"PlayerSpeaking\").speak(\"
				Something is wrong with this place. I have to get out of here.\")
				get_tree().get_first_node_in_group(\"audio_player\").stream = load(\"res://assets/audio/fx/crepy/violin1.mp3\")
				get_tree().get_first_node_in_group(\"audio_player\").play()
				BackgroundPlayer.stream = load(\"res://assets/audio/ambient/crescendo - phase one.mp3\")
				BackgroundPlayer.play()
				var tween2 : Tween = get_tree().create_tween().set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
				tween2.tween_property(BackgroundPlayer, \"volume_db\", 0.0, 0.5)
		)
	
"

